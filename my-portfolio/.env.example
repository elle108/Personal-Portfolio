# Firebase (admin login + message archive)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Contact form email delivery: get a free access key at https://web3forms.com
VITE_WEB3FORMS_KEY=

# Optional "Ask Elle" AI chat widget (see README)
# Server-only: no VITE_ prefix, so it is never bundled into client code
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5)
# ANTHROPIC_MODEL=
# Set to true to show the chat widget
VITE_ASK_ELLE=false
